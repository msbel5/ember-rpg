{
  "dialog_defs": [
    {
      "dialog_id": "guard_gate",
      "npc_id": "guard",
      "role": "guard",
      "states": [
        {
          "state_id": "greeting",
          "text": "The guard blocks the path, hand resting on a weapon.",
          "transitions": [
            {
              "transition_id": "show_papers",
              "text": "Show travel papers",
              "condition": {
                "condition_type": "item_check",
                "params": {
                  "item_def_id": "travel_papers"
                }
              },
              "next_state_id": "pass_granted",
              "actions": [
                {
                  "action_type": "take_item",
                  "params": {
                    "item_def_id": "travel_papers",
                    "quantity": 1
                  }
                }
              ]
            },
            {
              "transition_id": "bribe_guard",
              "text": "Offer a bribe [PRE 12]",
              "condition": {
                "condition_type": "stat_check",
                "params": {
                  "stat": "PRE",
                  "operator": ">=",
                  "value": 12
                }
              },
              "next_state_id": "pass_granted",
              "actions": [
                {
                  "action_type": "take_gold",
                  "params": {
                    "amount": 10
                  }
                }
              ]
            },
            {
              "transition_id": "intimidate_guard",
              "text": "Force your way past [MIG 14]",
              "condition": {
                "condition_type": "stat_check",
                "params": {
                  "stat": "MIG",
                  "operator": ">=",
                  "value": 14
                }
              },
              "next_state_id": "pass_granted",
              "hostile": true,
              "actions": [
                {
                  "action_type": "set_variable",
                  "params": {
                    "name": "guard_hostile",
                    "value": true
                  }
                }
              ]
            },
            {
              "transition_id": "ask_work_guard",
              "text": "Ask about local trouble",
              "next_state_id": "guard_info"
            },
            {
              "transition_id": "leave_guard",
              "text": "Leave",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "pass_granted",
          "text": "The guard steps aside. \"Move along.\"",
          "transitions": [
            {
              "transition_id": "pass_done",
              "text": "Continue on",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "guard_info",
          "text": "\"Wolves have been raiding caravans on the north road. Watch yourself out there.\"",
          "transitions": [
            {
              "transition_id": "guard_info_done",
              "text": "Noted. Farewell.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "merchant_shop",
      "npc_id": "merchant",
      "role": "merchant",
      "states": [
        {
          "state_id": "greeting",
          "text": "The merchant spreads their hands over the wares. \"See anything you like?\"",
          "transitions": [
            {
              "transition_id": "browse_wares",
              "text": "Browse the inventory",
              "next_state_id": "wares"
            },
            {
              "transition_id": "haggle",
              "text": "Negotiate a discount [PRE 13]",
              "condition": {
                "condition_type": "stat_check",
                "params": {
                  "stat": "PRE",
                  "operator": ">=",
                  "value": 13
                }
              },
              "next_state_id": "discount_offered",
              "actions": [
                {
                  "action_type": "set_variable",
                  "params": {
                    "name": "merchant_discount",
                    "value": true,
                    "scope": "global"
                  }
                }
              ]
            },
            {
              "transition_id": "ask_rumors_merchant",
              "text": "Ask about rumors",
              "next_state_id": "merchant_rumors"
            },
            {
              "transition_id": "leave_merchant",
              "text": "Leave",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "wares",
          "text": "\"I've got supplies for the road, weapons for the bold, and a few curiosities besides.\"",
          "transitions": [
            {
              "transition_id": "wares_back",
              "text": "Back",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "wares_done",
              "text": "That's all",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "discount_offered",
          "text": "\"Alright, alright. I'll knock a bit off the price for you. But don't tell anyone.\"",
          "transitions": [
            {
              "transition_id": "discount_done",
              "text": "Thanks. Let me browse.",
              "next_state_id": "wares"
            },
            {
              "transition_id": "discount_leave",
              "text": "Good. Farewell.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "merchant_rumors",
          "text": "\"They say the old mine south of town has been overrun. Goblins, maybe worse.\"",
          "transitions": [
            {
              "transition_id": "ask_mine_quest",
              "text": "I'll clear it out",
              "next_state_id": "quest_offered",
              "actions": [
                {
                  "action_type": "start_quest",
                  "params": {
                    "quest_id": "clear_mine",
                    "stage": "accepted"
                  }
                }
              ]
            },
            {
              "transition_id": "rumors_done",
              "text": "I'll keep that in mind",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "quest_offered",
          "text": "\"Brave soul. Bring back proof and I'll make it worth your while.\"",
          "transitions": [
            {
              "transition_id": "quest_done",
              "text": "Consider it done.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "innkeeper_tavern",
      "npc_id": "innkeeper",
      "role": "innkeeper",
      "states": [
        {
          "state_id": "greeting",
          "text": "The innkeeper wipes down the bar. \"Welcome, traveler. What'll it be?\"",
          "transitions": [
            {
              "transition_id": "rent_room_inn",
              "text": "Rent a room for the night",
              "next_state_id": "room_rented",
              "actions": [
                {
                  "action_type": "take_gold",
                  "params": {
                    "amount": 5
                  }
                }
              ]
            },
            {
              "transition_id": "ask_rumors_inn",
              "text": "What's the local gossip?",
              "next_state_id": "inn_rumors"
            },
            {
              "transition_id": "ask_supplies_inn",
              "text": "Do you have supplies for the road?",
              "next_state_id": "inn_supplies"
            },
            {
              "transition_id": "leave_inn",
              "text": "Nothing, thanks.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "room_rented",
          "text": "\"Room's upstairs, second door on the left. Rest well.\"",
          "transitions": [
            {
              "transition_id": "room_done",
              "text": "Rest for the night",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "inn_rumors",
          "text": "\"A strange fellow passed through last week. Asked about the ruins up north. Nobody goes there anymore.\"",
          "transitions": [
            {
              "transition_id": "inn_rumors_back",
              "text": "Interesting. Anything else?",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "inn_rumors_done",
              "text": "Thanks.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "inn_supplies",
          "text": "\"I've got dried rations and a few torches. Nothing fancy, but it'll keep you going.\"",
          "transitions": [
            {
              "transition_id": "inn_supplies_back",
              "text": "Back",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "inn_supplies_done",
              "text": "I'll manage.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "blacksmith_forge",
      "npc_id": "blacksmith",
      "role": "blacksmith",
      "states": [
        {
          "state_id": "greeting",
          "text": "Sparks fly as the blacksmith sets down the hammer. \"Need something made or mended?\"",
          "transitions": [
            {
              "transition_id": "buy_weapons",
              "text": "Show me your weapons",
              "next_state_id": "weapons_list"
            },
            {
              "transition_id": "repair_item",
              "text": "I need something repaired",
              "next_state_id": "repair_offer"
            },
            {
              "transition_id": "ask_craft",
              "text": "Can you craft something custom?",
              "condition": {
                "condition_type": "item_check",
                "params": {
                  "item_def_id": "iron_bar"
                }
              },
              "next_state_id": "custom_craft"
            },
            {
              "transition_id": "leave_smith",
              "text": "Just looking.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "weapons_list",
          "text": "\"Iron swords, axes, a few spearheads. All solid work.\"",
          "transitions": [
            {
              "transition_id": "weapons_back",
              "text": "Back",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "weapons_done",
              "text": "Maybe later.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "repair_offer",
          "text": "\"Bring me the piece and I'll see what I can do. Won't be cheap, mind.\"",
          "transitions": [
            {
              "transition_id": "repair_back",
              "text": "Back",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "repair_done",
              "text": "I'll think about it.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "custom_craft",
          "text": "\"You've got the materials. I can work with that. What did you have in mind?\"",
          "transitions": [
            {
              "transition_id": "craft_back",
              "text": "Back",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "craft_done",
              "text": "Let me think on it.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "healer_temple",
      "npc_id": "healer",
      "role": "healer",
      "states": [
        {
          "state_id": "greeting",
          "text": "The healer looks up from a mortar of herbs. \"You look like you could use some tending.\"",
          "transitions": [
            {
              "transition_id": "heal_me",
              "text": "I need healing",
              "next_state_id": "healing_done",
              "actions": [
                {
                  "action_type": "take_gold",
                  "params": {
                    "amount": 15
                  }
                },
                {
                  "action_type": "give_xp",
                  "params": {
                    "amount": 5
                  }
                }
              ]
            },
            {
              "transition_id": "buy_potions",
              "text": "Do you sell potions?",
              "next_state_id": "potion_list"
            },
            {
              "transition_id": "ask_identify",
              "text": "Can you identify this item? [INS 11]",
              "condition": {
                "condition_type": "stat_check",
                "params": {
                  "stat": "INS",
                  "operator": ">=",
                  "value": 11
                }
              },
              "next_state_id": "identify_offer"
            },
            {
              "transition_id": "leave_healer",
              "text": "I'm fine, thanks.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "healing_done",
          "text": "\"There. The herbs will do their work. Rest if you can.\"",
          "transitions": [
            {
              "transition_id": "healing_done_leave",
              "text": "Thank you.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "potion_list",
          "text": "\"I have a few remedies. Healing salves, antidotes, and a rare restorative.\"",
          "transitions": [
            {
              "transition_id": "potions_back",
              "text": "Back",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "potions_done",
              "text": "Not today.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "identify_offer",
          "text": "\"Bring the item here. My knowledge of the old texts may reveal its nature.\"",
          "transitions": [
            {
              "transition_id": "identify_back",
              "text": "Back",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "identify_done",
              "text": "I'll come back.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "rogue_alley",
      "npc_id": "rogue",
      "role": "rogue",
      "states": [
        {
          "state_id": "greeting",
          "text": "A shadowy figure leans against the alley wall, flipping a coin. \"Looking for trouble, or just lost?\"",
          "transitions": [
            {
              "transition_id": "ask_job",
              "text": "Ask if they have work",
              "next_state_id": "job_offer"
            },
            {
              "transition_id": "threaten_rogue",
              "text": "Threaten the rogue [MIG 13]",
              "condition": {
                "condition_type": "stat_check",
                "params": {
                  "stat": "MIG",
                  "operator": ">=",
                  "value": 13
                }
              },
              "next_state_id": "rogue_intimidated",
              "actions": [
                {
                  "action_type": "set_variable",
                  "params": {
                    "name": "rogue_intimidated",
                    "value": true
                  }
                }
              ]
            },
            {
              "transition_id": "pickpocket_rogue",
              "text": "Attempt to pickpocket [AGI 14]",
              "condition": {
                "condition_type": "stat_check",
                "params": {
                  "stat": "AGI",
                  "operator": ">=",
                  "value": 14
                }
              },
              "next_state_id": "pickpocket_result",
              "actions": [
                {
                  "action_type": "give_item",
                  "params": {
                    "item_def_id": "silver_coin",
                    "quantity": 3
                  }
                }
              ]
            },
            {
              "transition_id": "leave_rogue",
              "text": "Leave quietly",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "job_offer",
          "text": "\"Maybe. The merchant guild's got a shipment coming in. Could use a distraction.\"",
          "transitions": [
            {
              "transition_id": "accept_job",
              "text": "Accept the job",
              "next_state_id": "job_accepted",
              "actions": [
                {
                  "action_type": "start_quest",
                  "params": {
                    "quest_id": "guild_heist",
                    "stage": "accepted"
                  }
                }
              ]
            },
            {
              "transition_id": "decline_job",
              "text": "Not interested",
              "next_state_id": "greeting"
            }
          ]
        },
        {
          "state_id": "job_accepted",
          "text": "\"Smart choice. Meet me here at midnight. Don't be late.\"",
          "transitions": [
            {
              "transition_id": "job_done",
              "text": "Nod and leave",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "rogue_intimidated",
          "text": "The rogue raises their hands. \"Easy, friend. No need for violence.\"",
          "transitions": [
            {
              "transition_id": "intimidate_done",
              "text": "Back off",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "pickpocket_result",
          "text": "You deftly slip a few coins from the rogue's pouch. They don't seem to notice.",
          "transitions": [
            {
              "transition_id": "pickpocket_leave",
              "text": "Slip away",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "commoner_square",
      "npc_id": "commoner",
      "role": "commoner",
      "states": [
        {
          "state_id": "greeting",
          "text": "A weary villager glances up. \"Can I help you with something?\"",
          "transitions": [
            {
              "transition_id": "ask_news",
              "text": "Ask about recent news",
              "next_state_id": "news"
            },
            {
              "transition_id": "offer_help",
              "text": "Offer to help with chores [END 12]",
              "condition": {
                "condition_type": "stat_check",
                "params": {
                  "stat": "END",
                  "operator": ">=",
                  "value": 12
                }
              },
              "next_state_id": "chores_helped",
              "actions": [
                {
                  "action_type": "give_item",
                  "params": {
                    "item_def_id": "bread",
                    "quantity": 1
                  }
                },
                {
                  "action_type": "give_xp",
                  "params": {
                    "amount": 3
                  }
                }
              ]
            },
            {
              "transition_id": "ask_lost_item",
              "text": "Ask about a lost trinket",
              "next_state_id": "lost_item"
            },
            {
              "transition_id": "leave_commoner",
              "text": "Move on",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "news",
          "text": "\"The harvest's been poor, and folks are worried about bandits on the road.\"",
          "transitions": [
            {
              "transition_id": "news_done",
              "text": "Thanks for the info.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "chores_helped",
          "text": "\"Thank you! Not many lend a hand these days. Here, take this.\"",
          "transitions": [
            {
              "transition_id": "chores_done",
              "text": "Glad to help.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "lost_item",
          "text": "\"I did see something shiny by the well. Maybe check there?\"",
          "transitions": [
            {
              "transition_id": "lost_item_done",
              "text": "I'll look into it.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "villain_hideout",
      "npc_id": "villain",
      "role": "villain",
      "states": [
        {
          "state_id": "greeting",
          "text": "A sinister figure sits atop a crude throne. \"So, you've found me at last.\"",
          "transitions": [
            {
              "transition_id": "challenge_villain",
              "text": "Challenge the villain [MND 13]",
              "condition": {
                "condition_type": "stat_check",
                "params": {
                  "stat": "MND",
                  "operator": ">=",
                  "value": 13
                }
              },
              "next_state_id": "villain_challenged"
            },
            {
              "transition_id": "negotiate_villain",
              "text": "Attempt to negotiate [PRE 14]",
              "condition": {
                "condition_type": "stat_check",
                "params": {
                  "stat": "PRE",
                  "operator": ">=",
                  "value": 14
                }
              },
              "next_state_id": "villain_negotiated",
              "actions": [
                {
                  "action_type": "set_variable",
                  "params": {
                    "name": "villain_truce",
                    "value": true
                  }
                }
              ]
            },
            {
              "transition_id": "attack_villain",
              "text": "Attack immediately",
              "hostile": true,
              "next_state_id": "villain_fight"
            },
            {
              "transition_id": "leave_villain",
              "text": "Retreat for now",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "villain_challenged",
          "text": "\"You think words will sway me? Prove your worth, then!\"",
          "transitions": [
            {
              "transition_id": "villain_challenge_fight",
              "text": "Prepare to fight",
              "hostile": true,
              "next_state_id": "villain_fight"
            }
          ]
        },
        {
          "state_id": "villain_negotiated",
          "text": "The villain narrows their eyes. \"Perhaps we can come to an arrangement... for now.\"",
          "transitions": [
            {
              "transition_id": "villain_truce_done",
              "text": "Leave under truce",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "villain_fight",
          "text": "The villain draws a wicked blade. \"Let's end this.\"",
          "transitions": [
            {
              "transition_id": "fight_done",
              "text": "Fight!",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "quest_giver_square",
      "npc_id": "quest_giver",
      "role": "quest_giver",
      "states": [
        {
          "state_id": "greeting",
          "text": "A robed figure beckons you over. \"You look capable. Are you seeking work?\"",
          "transitions": [
            {
              "transition_id": "accept_quest",
              "text": "Ask about the job",
              "next_state_id": "quest_details"
            },
            {
              "transition_id": "decline_quest",
              "text": "Not interested",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "quest_details",
          "text": "\"Bandits have been harassing travelers near the old bridge. Deal with them, and you'll be rewarded.\"",
          "transitions": [
            {
              "transition_id": "take_quest",
              "text": "Accept the quest",
              "next_state_id": "quest_accepted",
              "actions": [
                {
                  "action_type": "start_quest",
                  "params": {
                    "quest_id": "clear_bandits",
                    "stage": "accepted"
                  }
                }
              ]
            },
            {
              "transition_id": "decline_after_details",
              "text": "Sounds too risky",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "quest_accepted",
          "text": "\"Return when the road is safe. The townsfolk will thank you.\"",
          "transitions": [
            {
              "transition_id": "quest_accepted_done",
              "text": "I'll be back.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "mayor_townhall",
      "npc_id": "mayor",
      "role": "mayor",
      "states": [
        {
          "state_id": "greeting",
          "text": "The mayor sits behind a heavy oak desk, poring over documents. \"Ah, the newcomer. I've heard of your arrival.\"",
          "transitions": [
            {
              "transition_id": "ask_town_state",
              "text": "How fares the settlement?",
              "next_state_id": "town_state"
            },
            {
              "transition_id": "ask_mayor_quest",
              "text": "Is there something I can do for the town?",
              "next_state_id": "mayor_quest_offer"
            },
            {
              "transition_id": "ask_politics",
              "text": "Tell me about the local factions",
              "next_state_id": "faction_info"
            },
            {
              "transition_id": "leave_mayor",
              "text": "I won't take more of your time.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "town_state",
          "text": "\"Supplies run thin and morale is slipping. The north road is barely passable, and our last courier never returned.\"",
          "transitions": [
            {
              "transition_id": "town_state_back",
              "text": "I see. What else?",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "town_state_done",
              "text": "Understood.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "mayor_quest_offer",
          "text": "\"Our supply caravan is three days overdue. I fear the worst. Find the caravan and bring back whatever you can salvage.\"",
          "transitions": [
            {
              "transition_id": "accept_caravan_quest",
              "text": "I'll find your caravan.",
              "next_state_id": "caravan_quest_accepted",
              "actions": [
                {
                  "action_type": "start_quest",
                  "params": { "quest_id": "missing_caravan", "stage": "accepted" }
                },
                {
                  "action_type": "add_journal",
                  "params": { "text": "The mayor asked me to find the missing supply caravan on the north road." }
                }
              ],
              "journal_entry": "Accepted the mayor's request to locate the missing supply caravan.",
              "journal_quest_id": "missing_caravan"
            },
            {
              "transition_id": "decline_caravan_quest",
              "text": "That sounds dangerous. Not now.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "caravan_quest_accepted",
          "text": "\"You have the town's gratitude. Speak to the guard captain for details on the route.\"",
          "transitions": [
            {
              "transition_id": "caravan_accepted_done",
              "text": "I'll head out.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "faction_info",
          "text": "\"The merchant guild holds the coin, the temple holds the faith, and the guard holds the peace. Balance is fragile.\"",
          "transitions": [
            {
              "transition_id": "faction_info_back",
              "text": "Tell me more.",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "faction_info_done",
              "text": "I'll keep that in mind.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "priest_chapel",
      "npc_id": "priest",
      "role": "priest",
      "states": [
        {
          "state_id": "greeting",
          "text": "The priest turns from the altar, hands clasped. \"Welcome, child. Do you seek solace or purpose?\"",
          "transitions": [
            {
              "transition_id": "ask_blessing",
              "text": "I could use a blessing.",
              "next_state_id": "blessing_given",
              "actions": [
                {
                  "action_type": "give_xp",
                  "params": { "amount": 5 }
                }
              ]
            },
            {
              "transition_id": "ask_undead_quest",
              "text": "I heard there are restless dead in the old cemetery.",
              "next_state_id": "undead_quest_offer"
            },
            {
              "transition_id": "ask_faith",
              "text": "Tell me about your faith.",
              "next_state_id": "faith_info"
            },
            {
              "transition_id": "leave_priest",
              "text": "I must go.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "blessing_given",
          "text": "\"May the light guide your path through the darkness ahead.\"",
          "transitions": [
            {
              "transition_id": "blessing_done",
              "text": "Thank you, father.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "undead_quest_offer",
          "text": "\"It is true. The dead do not rest. Something profane stirs beneath the old stones. Will you cleanse this blight?\"",
          "transitions": [
            {
              "transition_id": "accept_undead_quest",
              "text": "I will put them to rest.",
              "next_state_id": "undead_quest_accepted",
              "actions": [
                {
                  "action_type": "start_quest",
                  "params": { "quest_id": "cleanse_cemetery", "stage": "accepted" }
                },
                {
                  "action_type": "give_item",
                  "params": { "item_def_id": "holy_water", "quantity": 3 }
                },
                {
                  "action_type": "add_journal",
                  "params": { "text": "The priest gave me holy water and asked me to cleanse the cemetery of restless dead." }
                }
              ],
              "journal_entry": "Accepted the priest's request to cleanse the old cemetery.",
              "journal_quest_id": "cleanse_cemetery"
            },
            {
              "transition_id": "decline_undead",
              "text": "The dead can wait.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "undead_quest_accepted",
          "text": "\"Take this holy water. It will burn the unclean. Return when the ground is sanctified.\"",
          "transitions": [
            {
              "transition_id": "undead_accepted_done",
              "text": "I will return.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "faith_info",
          "text": "\"We serve the Light of Dawn. It demands compassion, vigilance, and the courage to face what festers in shadow.\"",
          "transitions": [
            {
              "transition_id": "faith_info_back",
              "text": "Interesting. What else can you tell me?",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "faith_info_done",
              "text": "I understand.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "bard_tavern",
      "npc_id": "bard",
      "role": "bard",
      "states": [
        {
          "state_id": "greeting",
          "text": "A bard strums an idle tune in the corner. \"Another wanderer! Sit down, I've got stories to trade.\"",
          "transitions": [
            {
              "transition_id": "ask_stories",
              "text": "Tell me a story about this place.",
              "next_state_id": "local_legend"
            },
            {
              "transition_id": "ask_bard_quest",
              "text": "Know anything worth investigating?",
              "next_state_id": "bard_lead"
            },
            {
              "transition_id": "report_caravan_found",
              "text": "I found the missing caravan.",
              "condition": {
                "condition_type": "variable_check",
                "params": { "name": "missing_caravan_found", "operator": "==", "value": true }
              },
              "next_state_id": "caravan_reward",
              "actions": [
                {
                  "action_type": "advance_quest",
                  "params": { "quest_id": "missing_caravan", "stage": "reported" }
                },
                {
                  "action_type": "give_gold",
                  "params": { "amount": 50 }
                },
                {
                  "action_type": "give_xp",
                  "params": { "amount": 40 }
                },
                {
                  "action_type": "set_reputation",
                  "params": { "faction_id": "town_council", "delta": 10 }
                }
              ],
              "journal_entry": "Reported the caravan's fate. The bard rewarded me on behalf of the town.",
              "journal_quest_id": "missing_caravan"
            },
            {
              "transition_id": "leave_bard",
              "text": "Maybe later.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "local_legend",
          "text": "\"They say the founders buried a sealed vault beneath the town square. No one's found the key in a hundred years.\"",
          "transitions": [
            {
              "transition_id": "legend_back",
              "text": "What else?",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "legend_done",
              "text": "Fascinating.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "bard_lead",
          "text": "\"A hermit in the eastern woods claims to have found something ancient. He trades knowledge for rare herbs.\"",
          "transitions": [
            {
              "transition_id": "bard_lead_back",
              "text": "Back.",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "bard_lead_done",
              "text": "I'll look into it.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "caravan_reward",
          "text": "\"Well done! The town owes you a debt. Here's what the council put together.\"",
          "transitions": [
            {
              "transition_id": "caravan_reward_done",
              "text": "Glad to help.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "scribe_archive",
      "npc_id": "scribe",
      "role": "scribe",
      "states": [
        {
          "state_id": "greeting",
          "text": "The scribe peers over spectacles at a stack of ledgers. \"Yes? I have little time for idle talk.\"",
          "transitions": [
            {
              "transition_id": "ask_records",
              "text": "I need access to the town records.",
              "next_state_id": "records_info"
            },
            {
              "transition_id": "ask_scribe_quest",
              "text": "Has anything unusual turned up in the archives?",
              "next_state_id": "archive_mystery"
            },
            {
              "transition_id": "report_cemetery_cleansed",
              "text": "The cemetery is cleansed. Here is proof.",
              "condition": {
                "condition_type": "variable_check",
                "params": { "name": "cemetery_cleansed", "operator": "==", "value": true }
              },
              "next_state_id": "cemetery_reward",
              "actions": [
                {
                  "action_type": "advance_quest",
                  "params": { "quest_id": "cleanse_cemetery", "stage": "verified" }
                },
                {
                  "action_type": "give_gold",
                  "params": { "amount": 35 }
                },
                {
                  "action_type": "give_xp",
                  "params": { "amount": 30 }
                },
                {
                  "action_type": "give_item",
                  "params": { "item_def_id": "scroll_of_protection", "quantity": 1 }
                }
              ],
              "journal_entry": "The scribe verified the cemetery cleansing and recorded the deed in the town archives.",
              "journal_quest_id": "cleanse_cemetery"
            },
            {
              "transition_id": "leave_scribe",
              "text": "I'll leave you to it.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "records_info",
          "text": "\"The records are open to citizens. For outsiders, you'll need the mayor's writ. What are you looking for?\"",
          "transitions": [
            {
              "transition_id": "records_back",
              "text": "Never mind.",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "records_done",
              "text": "I'll get that writ.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "archive_mystery",
          "text": "\"A sealed page from a century-old journal surfaced during reorganization. It mentions a ritual site in the hills. Someone should investigate.\"",
          "transitions": [
            {
              "transition_id": "archive_mystery_back",
              "text": "Interesting.",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "archive_mystery_done",
              "text": "I may look into that.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "cemetery_reward",
          "text": "\"Excellent. The deed is recorded. The temple sends its thanks, and here is a scroll for your trouble.\"",
          "transitions": [
            {
              "transition_id": "cemetery_reward_done",
              "text": "Thank you.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "sage_study",
      "npc_id": "sage",
      "role": "sage",
      "states": [
        {
          "state_id": "greeting",
          "text": "An elderly sage sits surrounded by open tomes and strange instruments. \"Knowledge is never free. What do you seek?\"",
          "transitions": [
            {
              "transition_id": "ask_lore",
              "text": "Tell me about the old ruins.",
              "next_state_id": "ruins_lore"
            },
            {
              "transition_id": "ask_identify_sage",
              "text": "Can you identify a magical artifact? [MND 12]",
              "condition": {
                "condition_type": "stat_check",
                "params": { "stat": "MND", "operator": ">=", "value": 12 }
              },
              "next_state_id": "identify_result",
              "actions": [
                {
                  "action_type": "take_gold",
                  "params": { "amount": 20 }
                }
              ]
            },
            {
              "transition_id": "ask_sage_quest",
              "text": "Do you need help with any research?",
              "next_state_id": "sage_quest_offer"
            },
            {
              "transition_id": "leave_sage",
              "text": "I should go.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "ruins_lore",
          "text": "\"The ruins north of here predate the current kingdom by three centuries. Built by a people who mastered wards of binding. Be cautious inside.\"",
          "transitions": [
            {
              "transition_id": "ruins_lore_back",
              "text": "What else do you know?",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "ruins_lore_done",
              "text": "I'll remember that.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "identify_result",
          "text": "\"Fascinating. This bears the mark of the Binding Order. Hold onto it carefully.\"",
          "transitions": [
            {
              "transition_id": "identify_sage_done",
              "text": "Thank you for the insight.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "sage_quest_offer",
          "text": "\"I need rare reagents from the marshlands south of the settlement. Swamp moss and cave lichen. Bring them back and I'll share what I've learned about the sealed vault.\"",
          "transitions": [
            {
              "transition_id": "accept_reagent_quest",
              "text": "I'll gather those for you.",
              "next_state_id": "reagent_quest_accepted",
              "actions": [
                {
                  "action_type": "start_quest",
                  "params": { "quest_id": "sage_reagents", "stage": "accepted" }
                },
                {
                  "action_type": "add_journal",
                  "params": { "text": "The sage needs swamp moss and cave lichen from the southern marshlands." }
                }
              ],
              "journal_entry": "Accepted the sage's request to gather rare reagents.",
              "journal_quest_id": "sage_reagents"
            },
            {
              "transition_id": "decline_reagent_quest",
              "text": "Not right now.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "reagent_quest_accepted",
          "text": "\"Good. Be warned: the marshlands are not safe after dark.\"",
          "transitions": [
            {
              "transition_id": "reagent_accepted_done",
              "text": "I'll be careful.",
              "terminates": true
            }
          ]
        }
      ]
    },
    {
      "dialog_id": "witch_cottage",
      "npc_id": "witch",
      "role": "witch",
      "states": [
        {
          "state_id": "greeting",
          "text": "A weathered woman stirs a bubbling pot in a cluttered cottage. \"Come in, come in. I knew you'd find me.\"",
          "transitions": [
            {
              "transition_id": "ask_potions_witch",
              "text": "Do you brew potions?",
              "next_state_id": "potion_trade"
            },
            {
              "transition_id": "ask_curse",
              "text": "I've heard there's a curse on the old mill.",
              "next_state_id": "curse_info"
            },
            {
              "transition_id": "return_reagents",
              "text": "I've brought the reagents the sage asked for.",
              "condition": {
                "condition_type": "item_check",
                "params": { "item_def_id": "swamp_moss" }
              },
              "next_state_id": "reagent_turnin",
              "actions": [
                {
                  "action_type": "take_item",
                  "params": { "item_def_id": "swamp_moss", "quantity": 1 }
                },
                {
                  "action_type": "take_item",
                  "params": { "item_def_id": "cave_lichen", "quantity": 1 }
                },
                {
                  "action_type": "advance_quest",
                  "params": { "quest_id": "sage_reagents", "stage": "delivered" }
                },
                {
                  "action_type": "give_gold",
                  "params": { "amount": 40 }
                },
                {
                  "action_type": "give_xp",
                  "params": { "amount": 35 }
                }
              ],
              "journal_entry": "Delivered the reagents. The witch paid me for the trouble.",
              "journal_quest_id": "sage_reagents"
            },
            {
              "transition_id": "leave_witch",
              "text": "I should be going.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "potion_trade",
          "text": "\"I deal in remedies most alchemists won't touch. Antidotes, night-vision draughts, and a tonic that sharpens the mind.\"",
          "transitions": [
            {
              "transition_id": "potion_trade_back",
              "text": "Back.",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "potion_trade_done",
              "text": "I'll think on it.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "curse_info",
          "text": "\"The mill curse is real. An old grudge between two families, sealed with blood magic. It can be lifted, but you'll need a silver mirror and a willing heart.\"",
          "transitions": [
            {
              "transition_id": "curse_info_back",
              "text": "How do I lift it?",
              "next_state_id": "greeting"
            },
            {
              "transition_id": "curse_info_done",
              "text": "Interesting.",
              "terminates": true
            }
          ]
        },
        {
          "state_id": "reagent_turnin",
          "text": "\"Perfect. These will do nicely. The sage will be pleased. Here's something for your trouble.\"",
          "transitions": [
            {
              "transition_id": "reagent_turnin_done",
              "text": "Glad to help.",
              "terminates": true
            }
          ]
        }
      ]
    }
  ]
}
